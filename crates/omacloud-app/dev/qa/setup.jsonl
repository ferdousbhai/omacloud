# First run on a computer whose storage Omacloud left: setup, one question at a time, through to the recovery code.
# dev/qa.sh target/debug/omacloud-app dev/qa/setup.jsonl [directory for the shots]
# state: gone

# The tabs mean nothing yet; the toast says why setup is back.
{"do":"wait","role":"button","name":"Set Up With Dropbox","visible":true}
{"do":"wait","role":"button","name":"Sync now","visible":false}
{"do":"wait","toasts":["This computer was set up on Hetzner Storage Box, which Omacloud no longer uses. Set it up again: your files here stay as they are."]}
{"do":"shot","path":"welcome.png"}

# Your own storage: the keyboard starts in the form, an empty one says what it needs, and Escape goes back.
{"do":"click","role":"button","name":"Use My Own Storage"}
{"do":"wait","role":"button","name":"Create Account","visible":true}
{"do":"shot","path":"own-storage.png"}
{"do":"click","role":"button","name":"Create Account"}
{"do":"wait","toasts":["Fill in where your bucket is, and its key"]}
{"do":"key","keys":"Escape"}
{"do":"wait","role":"button","name":"Create Account","visible":false}

# Joining: an empty code says so.
{"do":"click","role":"button","name":"I Already Use Omacloud"}
{"do":"wait","role":"button","name":"Add This Computer","visible":true}
{"do":"shot","path":"join.png"}
{"do":"click","role":"button","name":"Add This Computer"}
{"do":"wait","toasts":["Paste the join code or invite"]}
{"do":"click","role":"button","name":"Back"}
{"do":"wait","role":"button","name":"Add This Computer","visible":false}

# Dropbox: One Moment while it sets up, then the recovery code. Neither Copy nor Escape closes it: only its last four
# characters typed back let it close.
{"do":"click","role":"button","name":"Set Up With Dropbox"}
{"do":"wait","role":"button","name":"Continue","visible":true}
{"do":"shot","path":"what-to-sync.png"}
{"do":"click","role":"button","name":"Continue"}
{"do":"wait","dialog":"One Moment"}
{"do":"shot","path":"one-moment.png"}
{"do":"wait","dialog":"Your recovery code","timeout_ms":10000}
{"do":"wait","role":"button","name":"I Wrote It Down","sensitive":false}
{"do":"wait","focus":{"role":"text-box","name":"Type its last four characters"}}
{"do":"shot","path":"recovery-code.png"}
{"do":"click","role":"button","name":"Copy"}
{"do":"wait","dialog":"Your recovery code"}
{"do":"key","keys":"Escape"}
{"do":"wait","dialog":"Your recovery code"}
{"do":"type","text":"4yzb","role":"text-box","name":"Type its last four characters"}
{"do":"wait","role":"button","name":"I Wrote It Down","sensitive":true}
{"do":"shot","path":"recovery-code-typed.png"}
{"do":"click","role":"button","name":"I Wrote It Down"}
{"do":"wait","dialog":null}

# Set up: the account's pages and their tabs.
{"do":"wait","role":"button","name":"Sync now","visible":true}
{"do":"wait","role":"button","name":"Open on a Phone…","visible":true}
{"do":"shot","path":"set-up.png"}
{"do":"quit"}
