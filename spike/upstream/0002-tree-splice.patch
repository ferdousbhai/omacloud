@@ -0,0 +1,160 @@
+use std::{io::Cursor, path::PathBuf, str::FromStr};
+
+use anyhow::Result;
+use rstest::rstest;
+
+use rustic_core::{
+    BackupOptions, CheckOptions, LsOptions, TreeEdit, TreeId,
+    repofile::{Metadata, Node, NodeType, SnapshotFile},
+};
+
+use super::{RepoOpen, TestSource, set_up_repo, tar_gz_testdata};
+
+fn file_node(name: &str, body: &[u8]) -> Node {
+    let meta = Metadata {
+        size: body.len() as u64,
+        mode: Some(0o644),
+        ..Metadata::default()
+    };
+    Node::new_node(name.as_ref(), NodeType::File, meta)
+}
+
+fn put(name: &str, body: &'static [u8]) -> TreeEdit {
+    TreeEdit::PutFile {
+        node: file_node(name, body),
+        reader: Box::new(Cursor::new(body)),
+    }
+}
+
+#[rstest]
+fn test_splice_tree(
+    tar_gz_testdata: Result<TestSource>,
+    set_up_repo: Result<RepoOpen>,
+) -> Result<()> {
+    let (source, repo) = (tar_gz_testdata?, set_up_repo?.to_indexed_ids()?);
+    let opts = BackupOptions::default().as_path(PathBuf::from_str("test")?);
+    let snap = repo.backup(&opts, &source.path_list(), SnapshotFile::default())?;
+    let repo = repo.to_indexed()?;
+
+    // pick two files in different top level directories of the snapshot
+    let root = repo.node_from_snapshot_and_path(&snap, "")?;
+    let files: Vec<PathBuf> = repo
+        .ls(&root, &LsOptions::default().recursive(true))?
+        .filter_map(Result::ok)
+        .filter(|(_, node)| node.is_file())
+        .map(|(path, _)| path)
+        .collect();
+    let changed = files[0].clone();
+    let deleted = files
+        .iter()
+        .find(|p| p.parent() != changed.parent())
+        .unwrap_or(&files[1])
+        .clone();
+
+    let new_root = repo.splice_tree(
+        Some(snap.tree),
+        [
+            (changed.clone(), put("ignored", b"changed\n")),
+            (deleted.clone(), TreeEdit::Delete),
+            (PathBuf::from("new/dir/file.txt"), put("file.txt", b"new\n")),
+        ],
+    )?;
+    assert_ne!(new_root, snap.tree);
+
+    // saving returns the id, and the snapshot reads back
+    let new_snap = SnapshotFile {
+        tree: new_root,
+        parent: Some(snap.id),
+        ..SnapshotFile::default()
+    };
+    let id = repo.save_snapshot(&new_snap)?;
+
+    // re-read the index to see the blobs splice wrote
+    let repo = repo.to_indexed()?;
+    let new_snap = repo.get_snapshots(&[id.to_string()])?.remove(0);
+    assert_eq!(new_snap.tree, new_root);
+
+    let dump = |path: &str| -> Result<Vec<u8>> {
+        let node = repo.node_from_snapshot_and_path(&new_snap, path)?;
+        let mut out = Vec::new();
+        repo.dump(&node, &mut out)?;
+        Ok(out)
+    };
+    assert_eq!(dump(changed.to_str().unwrap())?, b"changed\n");
+    assert_eq!(dump("new/dir/file.txt")?, b"new\n");
+    assert!(
+        repo.node_from_snapshot_and_path(&new_snap, deleted.to_str().unwrap())
+            .is_err()
+    );
+    // the node is stored under its path's name, not the name given in the node
+    let name = changed.file_name().unwrap();
+    let node = repo.node_from_snapshot_and_path(&new_snap, changed.to_str().unwrap())?;
+    assert_eq!(node.name(), name);
+
+    // subtrees without edits keep their ids
+    let subtrees = |tree: TreeId| -> Result<Vec<(String, Option<TreeId>)>> {
+        Ok(repo
+            .get_tree(&tree)?
+            .nodes
+            .into_iter()
+            .map(|n| (n.name().to_string_lossy().into_owned(), n.subtree))
+            .collect())
+    };
+    let touched =
+        |name: &str| [&changed, &deleted].iter().any(|p| p.starts_with(name)) || name == "new";
+    for (name, subtree) in subtrees(snap.tree)? {
+        if !touched(&name) {
+            assert!(subtrees(new_root)?.contains(&(name, subtree)));
+        }
+    }
+
+    repo.check(CheckOptions::default().read_data(true))?
+        .is_ok()?;
+
+    // a directory put without a subtree: a new one starts empty, and one
+    // emptied by a delete in the same splice stays
+    let dir = |name: &str| {
+        TreeEdit::Put(Node::new_node(
+            name.as_ref(),
+            NodeType::Dir,
+            Metadata::default(),
+        ))
+    };
+    let root3 = repo.splice_tree(
+        Some(new_root),
+        [
+            (PathBuf::from("empty/dir"), dir("dir")),
+            (PathBuf::from("new/dir/file.txt"), TreeEdit::Delete),
+            (PathBuf::from("new/dir"), dir("dir")),
+        ],
+    )?;
+    let repo = repo.to_indexed()?;
+    let snap3 = SnapshotFile {
+        tree: root3,
+        ..SnapshotFile::default()
+    };
+    for path in ["empty/dir", "new/dir"] {
+        let node = repo.node_from_snapshot_and_path(&snap3, path)?;
+        assert!(node.is_dir(), "{path}");
+        assert!(
+            repo.get_tree(&node.subtree.unwrap())?.nodes.is_empty(),
+            "{path}"
+        );
+    }
+    // the rest of the tree is untouched
+    let node = repo.node_from_snapshot_and_path(&snap3, changed.to_str().unwrap())?;
+    let mut out = Vec::new();
+    repo.dump(&node, &mut out)?;
+    assert_eq!(out, b"changed\n");
+    repo.check(CheckOptions::default())?.is_ok()?;
+
+    // invalid paths are rejected
+    for bad in ["", "/abs", "a/../b", "./a"] {
+        assert!(
+            repo.splice_tree(Some(new_root), [(bad, TreeEdit::Delete)])
+                .is_err(),
+            "path {bad:?} should be rejected"
+        );
+    }
+    Ok(())
+}
