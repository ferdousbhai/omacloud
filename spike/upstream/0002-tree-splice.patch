 impl<S: IndexedIds> Repository<S> {
+    /// Apply `edits` to the tree `root` (`None` for an empty tree) and return
+    /// the id of the new root tree.
+    ///
+    /// Only the trees on the paths from each edit to the root are read and
+    /// rewritten; all other subtrees keep their ids. File content given with
+    /// [`TreeEdit::PutFile`] is chunked with the repository's chunker and
+    /// deduplicated against the index. Writes at most one data pack, one tree
+    /// pack and one index file (more only if they exceed the pack size).
+    /// Directories created along the way get mode `0755`; directories left
+    /// empty by deletions are removed.
+    ///
+    /// # Arguments
+    ///
+    /// * `root` - The tree to edit
+    /// * `edits` - Paths relative to `root`, each with the edit to apply
+    ///
+    /// # Errors
+    ///
+    /// * If a path is empty, absolute, or contains `.` or `..`.
+    /// * If reading content or writing to the backend fails.
+    pub fn splice_tree<P: AsRef<Path>>(
+        &self,
+        root: Option<TreeId>,
+        edits: impl IntoIterator<Item = (P, TreeEdit)>,
+    ) -> RusticResult<TreeId> {
+        TreeSplicer::new(self.dbe(), self.index(), self.config())?.splice(root, edits)
+    }
+
