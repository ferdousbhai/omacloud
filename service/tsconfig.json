{
  "compilerOptions": {
    "target": "es2023",
    "lib": [
      "es2023"
    ],
    "module": "es2022",
    "moduleResolution": "bundler",
    "types": [
      "@cloudflare/vitest-pool-workers/types"
    ],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "isolatedModules": true
  },
  "include": [
    "worker-configuration.d.ts",
    "src",
    "test"
  ]
}
