{
  "name": "onecloud-web",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "check": "tsc --noEmit && tsc --noEmit -p web",
    "test": "pnpm build:web && vitest run",
    "cf-typegen": "wrangler types",
    "build:web": "esbuild web/app.ts --bundle --format=esm --target=es2022 --minify --outfile=public/app.js"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.22.0",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11",
    "wrangler": "^4.141.0"
  },
  "packageManager": "pnpm@11.26.0",
  "dependencies": {
    "aws4fetch": "^1.0.20"
  }
}
