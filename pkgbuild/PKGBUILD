# Maintainer: Ferdous Bhai <https://github.com/ferdousbhai>
#
# Builds from this checkout; a plain `makepkg` in this directory builds the
# package locally. Signed releases will follow icloud-notes' workflow.

pkgname=onecloud
pkgver=0.0.0.r4
pkgrel=1
pkgdesc='OneCloud: your files and settings on every computer, end to end encrypted'
arch=('x86_64')
url='https://github.com/ferdousbhai/onecloud'
license=('MIT')
options=('!debug' '!lto')
depends=('glibc' 'libgcc' 'gtk4' 'libadwaita' 'libsecret')
makedepends=('cargo' 'git')
optdepends=('restic: restore without onecloud (see `onecloud export`)')

# The version is the git tag: v0.1.0 builds 0.1.0, and a commit past it
# builds 0.1.0.r<count>.<sha> so `pacman -Q` says where a build came from.
pkgver() {
  git -C "$startdir/.." describe --tags --long 2>/dev/null |
    sed 's/^v//; s/-\([0-9]*\)-g\([0-9a-f]*\)$/.r\1.\2/; s/\.r0\.[0-9a-f]*$//' |
    grep . || printf '0.0.0.r%s\n' "$(git -C "$startdir/.." rev-list --count HEAD)"
}

prepare() {
  # Only committed files: a release build never picks up local leftovers.
  mkdir -p "$srcdir/$pkgname"
  git -C "$startdir/.." archive HEAD | tar -x -C "$srcdir/$pkgname"
  cd "$srcdir/$pkgname"
  export RUSTUP_TOOLCHAIN=stable
  cargo fetch --locked --target "$(rustc -vV | sed -n 's/host: //p')"
}

build() {
  cd "$srcdir/$pkgname"
  export RUSTUP_TOOLCHAIN=stable
  export CARGO_TARGET_DIR=target
  cargo build --frozen --release -p onecloud -p onecloud-app
}

check() {
  cd "$srcdir/$pkgname"
  export RUSTUP_TOOLCHAIN=stable
  cargo test --frozen --release -p onecloud-core --lib
}

package() {
  cd "$srcdir/$pkgname"
  install -Dm755 target/release/onecloud "$pkgdir/usr/bin/onecloud"
  install -Dm755 target/release/onecloud-app "$pkgdir/usr/bin/onecloud-app"
  install -Dm644 contrib/computer.onecloud.OneCloud.desktop \
    "$pkgdir/usr/share/applications/computer.onecloud.OneCloud.desktop"
  install -Dm644 contrib/onecloud.service "$pkgdir/usr/lib/systemd/user/onecloud.service"
  # Enabled for every user by the package, so an update through pacman
  # turns it on too; the unit's condition skips users without onecloud.
  install -dm755 "$pkgdir/usr/lib/systemd/user/default.target.wants"
  ln -s ../onecloud.service "$pkgdir/usr/lib/systemd/user/default.target.wants/onecloud.service"
  install -Dm644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
