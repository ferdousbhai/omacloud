+use std::{path::PathBuf, str::FromStr, sync::Arc};
+
+use anyhow::Result;
+use rstest::rstest;
+
+use rustic_core::{
+    BackupOptions, CheckOptions, ConfigOptions, Credentials, FileType, KeyOptions, PruneOptions,
+    ReadBackend, Repository, RepositoryBackends, RepositoryOptions,
+    repofile::{MasterKey, SnapshotFile},
+};
+use rustic_testing::backend::in_memory_backend::InMemoryBackend;
+
+use super::{TestSource, tar_gz_testdata};
+
+/// Padmé, written independently of the implementation under test.
+fn is_padme(len: u32) -> bool {
+    if len < 2 {
+        return true;
+    }
+    let e = len.ilog2();
+    let s = e.ilog2() + 1;
+    len.trailing_zeros() >= e - s
+}
+
+#[rstest]
+fn test_pack_padding(tar_gz_testdata: Result<TestSource>) -> Result<()> {
+    let source = tar_gz_testdata?;
+    let be = Arc::new(InMemoryBackend::new());
+    let backends = RepositoryBackends::new(be.clone(), None);
+    let config_opts = ConfigOptions::default().set_pack_padding(true);
+    let repo = Repository::new(&RepositoryOptions::default(), &backends)?.init(
+        &Credentials::Masterkey(MasterKey::new()),
+        &KeyOptions::default(),
+        &config_opts,
+    )?;
+    assert!(repo.config().pack_padding());
+
+    let repo = repo.to_indexed_ids()?;
+    let opts = BackupOptions::default().as_path(PathBuf::from_str("test")?);
+    _ = repo.backup(&opts, &source.path_list(), SnapshotFile::default())?;
+
+    let assert_padded = || -> Result<()> {
+        let packs = be.list_with_size(FileType::Pack)?;
+        assert!(!packs.is_empty());
+        for (id, size) in packs {
+            assert!(
+                is_padme(size),
+                "pack {id} has size {size}, not a Padmé size"
+            );
+        }
+        Ok(())
+    };
+    assert_padded()?;
+    repo.check(CheckOptions::default().read_data(true))?
+        .is_ok()?;
+
+    // prune drops the padding blobs as unused; repacked packs are padded again
+    let prune_opts = PruneOptions::default().instant_delete(true);
+    let plan = repo.prune_plan(&prune_opts)?;
+    repo.prune(&prune_opts, plan)?;
+    assert_padded()?;
+    repo.check(CheckOptions::default().read_data(true))?
+        .is_ok()?;
+
+    Ok(())
+}
