@@ -526,6 +544,22 @@ impl<BE: DecryptWriteBackend> RawPacker<BE> {
         Ok(())
     }
 
+    /// Adds one random data blob so that the finished pack is exactly a Padmé
+    /// size. It's an ordinary indexed blob (its id is the hash of its
+    /// plaintext), so the pack stays a valid restic pack; prune sees it as
+    /// unused and drops it on the next repack, which pads again.
+    fn pad(&mut self) -> RusticResult<()> {
+        let header =
+            PackHeaderRef::from_index_pack(&self.basic.index).size() + HeaderEntry::ENTRY_LEN;
+        let unpadded = self.basic.size + CRYPTO_OVERHEAD + header + PackHeaderLength::LEN;
+        let len = padme(unpadded) - unpadded;
+        let mut plain = vec![0u8; len as usize];
+        rng().fill_bytes(&mut plain);
+        let id = BlobId::from(hash(&plain));
+        let data = self.be.key().encrypt_data(&plain)?;
+        self.basic.add_raw(data.into(), &id, u64::from(len), None)
+    }
+
     fn has(&self, id: &BlobId) -> bool {
         self.basic.has(id)
     }
@@ -1097,3 +1131,43 @@ mod tests {
         assert_ron_snapshot!(output);
     }
 }
+
+/// Encryption overhead of one blob: 16 byte IV plus 16 byte MAC.
+const CRYPTO_OVERHEAD: u32 = 32;
+
+/// Padmé (Nikitin et al., PETS 2019): round `len` up so that only the top
+/// `floor(log2(log2(len))) + 1` bits of the size vary. Overhead is at most 12%,
+/// and a size reveals O(log log n) bits instead of O(log n).
+pub(crate) const fn padme(len: u32) -> u32 {
+    if len < 2 {
+        return len;
+    }
+    let e = 31 - len.leading_zeros(); // floor(log2 len)
+    let s = 32 - e.leading_zeros(); // floor(log2 e) + 1
+    let mask = (1u32 << (e - s)) - 1;
+    (len + mask) & !mask
+}
+
+#[cfg(test)]
+mod padme_tests {
+    use super::padme;
+
+    #[test]
+    fn padme_matches_the_paper() {
+        // values from the Padmé definition: only the top log2(log2 L) + 1 bits vary
+        assert_eq!(padme(0), 0);
+        assert_eq!(padme(1), 1);
+        assert_eq!(padme(9), 10);
+        assert_eq!(padme(1000), 1024);
+        assert_eq!(padme(1025), 1088);
+        assert_eq!(padme(1_000_000), 1_015_808);
+        for len in 2..200_000u32 {
+            let p = padme(len);
+            assert!(p >= len && padme(p) == p);
+            assert!(
+                u64::from(p - len) * 100 <= u64::from(len) * 12,
+                "{len} -> {p}"
+            );
+        }
+    }
+}
