[Unit]
Description=Keep the omacloud folder in sync
Documentation=https://github.com/ferdousbhai/omacloud
After=network-online.target
# the package enables this for every user; it runs for those who set up
# omacloud (`omacloud init`)
ConditionPathExists=%h/.config/omacloud/config.toml

[Service]
ExecStart=/usr/bin/omacloud watch
Restart=on-failure
RestartSec=10
# exit code 2: removed from the account, or the coordinator served a history
# this device refuses; a human has to look, so don't restart into it
RestartPreventExitStatus=2

[Install]
WantedBy=default.target
